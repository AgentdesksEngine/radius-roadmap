# --- Supabase ---
# Project Settings → API. The service role key is server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string → Transaction pooler (port 6543).
DATABASE_URL=

# Same two values as above, Vite-exposed for the browser client (src/lib/supabaseClient.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domain allowed to sign in (checked server-side, not just via Google's `hd` hint).
# The real gate is profiles.allowed, set by the handle_new_user trigger in 0001_init.sql.
ALLOWED_EMAIL_DOMAIN=radiusagent.com

# --- App ---
# Linear-style key shown in the UI: RAD-42
ISSUE_KEY_PREFIX=RAD
# Public origin. Drives the Google redirect AND every issue deep link the app generates —
# including the ones in Slack DMs and the bot's thread replies. Production is
# https://radius-roadmap.vercel.app (bugtracker.radiusagents.com does not resolve).
APP_URL=http://localhost:5173

# --- Slack ingest + notification DMs (api/slack/[action].ts, api/_lib/notify.ts) ---
# api.slack.com/apps → your app → Basic Information → Signing Secret, and
# OAuth & Permissions → Bot User OAuth Token (xoxb-...). See README "Slack ingest".
# Notification DMs need the `im:write` scope on top of the ingest scopes — adding it means
# reinstalling the app.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# The app's own user id (OAuth & Permissions). Lets it ignore its own thread replies.
SLACK_BOT_USER_ID=
# Reaction that captures a bug, without the colons.
SLACK_TRIGGER_EMOJI=bug
# Comma-separated channel-id allowlist. Empty = any channel the app was invited to.
# #product-critical-bugs is C31A2FA3F.
SLACK_INGEST_CHANNELS=

# --- Local development only (never set in production) ---
# One fixed Supabase account (email/password provider enabled just for this account) so
# `/api/auth/dev-login` works without real email delivery.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# --- GitHub PR webhook (live: api/github/[action].ts) ---
# Secret you set on the GitHub App / org webhook. The handler needs nothing else from GitHub:
# repo, PR number, title, body, branch, merged and draft all arrive in the payload, so there is
# no token to mint or rotate. Webhook URL: <APP_URL>/api/github/webhook, content type JSON,
# "Pull request" event only. See README "GitHub pull requests".
GITHUB_WEBHOOK_SECRET=
# PRs from repos outside this org are ignored even when the signature is valid.
GITHUB_ORG=AgentdesksEngine

# --- GitHub (migration tooling only — scripts/migrate-github-to-supabase.ts and its
# dump-schema/provision-fields helpers; unused by the live API; removed once the migration
# is done, see the cutover plan's Phase 4) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PROJECT_NUMBER=6
GITHUB_ISSUES_REPO=radius-roadmap
DEV_GITHUB_TOKEN=
GITHUB_TOKEN=
