# --- GitHub App (created by an AgentdesksEngine org owner, installed on the org) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; keep the literal "\n" escapes if you paste it on one line.
GITHUB_APP_PRIVATE_KEY=

# --- Board location ---
GITHUB_ORG=AgentdesksEngine
GITHUB_PROJECT_NUMBER=6
GITHUB_ISSUES_REPO=radius-roadmap
# Linear-style key shown in the UI: RAD-42
ISSUE_KEY_PREFIX=RAD

# --- App ---
# 32+ random characters. `openssl rand -base64 48`
SESSION_SECRET=
# Public origin used for the OAuth redirect_uri. Local dev: http://localhost:5173
APP_URL=http://localhost:5173

# --- Local development only (never set in production) ---
# A personal token (e.g. `gh auth token`) lets /api/auth/dev-login create a session
# before the GitHub App exists. Ignored when VERCEL_ENV=production.
DEV_GITHUB_TOKEN=
# Used by scripts/*.ts. Falls back to `gh auth token` when unset.
GITHUB_TOKEN=
